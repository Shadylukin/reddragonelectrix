---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CallBar from '../components/CallBar.astro'
import PlateLabel from '../components/PlateLabel.astro'
import { site, services, reviews, jobLog, evInstallSpec } from '../data/site'

const title = 'Auckland Electricians | Red Dragon Electrix'
const description =
  'Registered Auckland electrician. Switchboards, rewires, lighting, power points and EV charger installation. EWRB registered. Call Nick on 0210 918 6333.'

const lead = reviews[0]
const rest = reviews.slice(1, 4)

// Symptom-triggered prompts. A generic "get in touch" converts worse than naming
// the thing that made the person open the page in the first place.
const prompts: Record<string, string> = {
  'ev-chargers': 'Got the car on order? Ring me before the charger arrives.',
  residential: 'Something tripping, buzzing or burnt-smelling? Ring me, don’t wait.',
  commercial: 'Need it fixed before you open tomorrow? Ring me.',
}
---

<Base title={title} description={description} path="/">
  <Header />
  <main id="main">
    <!-- 01 HERO -->
    <section class="wrap" style="padding-top:0">
      <div class="hero-grid">
        <div>
          <figure class="hero-figure">
            <span class="hero-tab">01&nbsp;&nbsp;AUCKLAND</span>
            <img
              src="/img/hero-switchboard.jpg"
              alt="Nick from Red Dragon Electrix working on an open switchboard, wearing a branded jacket"
              width="1497" height="2000" fetchpriority="high"
            />
          </figure>
          <div class="hero-caption">
            <span class="who">That’s Nick. This is his work.</span>
            <span class="what">Switchboard upgrade, in progress</span>
          </div>
        </div>

        <div class="hero-body">
          <h1 class="h1">
            {site.tagline}
            <span class="accent">{site.taglineAccent}</span>
          </h1>
          <p class="hero-sub">{site.taglineSecondary}</p>

          <p class="credentials">
            <b>EWRB</b> registered<span class="sep">·</span>
            <b>CoC</b> on every job<span class="sep">·</span>
            <b>AS/NZS 3000:2018</b><span class="sep">·</span>
            <b>{site.rating.value}</b> from {site.rating.count} reviews
          </p>

          <div class="doors">
            {services.map((s, i) => (
              <a class="door" href={`/${s.slug}/`}>
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="nm">{s.navLabel}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="hazard"></div>

    <!-- 02 REVIEWS — deliberately at position two, on flat black between two photographic sections -->
    <section class="wrap">
      <PlateLabel idx="02" name="What the neighbours said" note="Customer reviews, unedited" />
      <h2 class="h2">{site.rating.count} reviews.<br />Averaging {site.rating.value} out of 5.</h2>
      <p class="lede">
        Averages are easy to claim, so here are some of them word for word — names and all.
      </p>
      <blockquote class="quote-lead" style="margin-top:26px">
        <p>{lead.body}</p>
        <p class="attr"><span class="nm">{lead.author}</span> <span class="src">· customer review</span></p>
      </blockquote>
      <div class="quote-grid">
        {rest.map((r) => (
          <blockquote>
            <p>{r.body}</p>
            <p class="attr"><span class="nm">{r.author}</span> <span class="src">· customer review</span></p>
          </blockquote>
        ))}
      </div>
    </section>

    <!-- 03 SERVICES -->
    <section class="wrap">
      <PlateLabel idx="03" name="What we do" note="Three trades, one team, one number" />
      <div class="plates">
        {services.map((s, i) => (
          <article class="plate-card">
            <div class="shot">
              <img src={s.image} alt={s.imageAlt ?? ''} width="800" height="800" loading="lazy" />
              <span class="tag">
                <span class="i">{String(i + 1).padStart(2, '0')}</span>
                <span class="n">{s.navLabel}</span>
              </span>
            </div>
            <div class="inner">
              <h3>{s.title}</h3>
              <p class="desc">{s.description}</p>
              <ul class="spec">
                {s.items.slice(0, 6).map((item) => <li>{item}</li>)}
              </ul>
              <a class="plate-call" href={site.phone.href}>
                <span class="prompt">{prompts[s.slug]}</span>
                <span class="row">
                  <span class="l">CALL NICK</span>
                  <span class="d">{site.phone.display}</span>
                </span>
              </a>
              <a class="plate-sms" href={`sms:${site.phone.e164}`}>
                <span>Or text a photo of the problem</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 04 EV DETAIL + INSTALL SPEC — the first paper register shift.
         tesla-charger.jpg is a studio shot on a near-white seamless. Forced onto
         black it punches a glowing hole; given its own document card it reads as
         intentional. -->
    <section class="wrap">
      <PlateLabel idx="04" name="EV charging" note="Manufacturer-trained, incl. Tesla" />
      <div class="ev-grid">
        <div>
          <h2 class="h2">The supply gets checked before anything goes on the wall</h2>
          <p class="lede">
            Most EV charger jobs are decided before a single hole is drilled. What the main
            supply can carry, whether the board has room, how far the run is from the board
            to where the car actually parks. Get that wrong and you either trip the house
            every time the car charges, or you pay for a board upgrade you didn't need.
          </p>
          <p class="lede">
            Text a photo of your switchboard and where you park. Most of the time that's
            enough to quote it without a visit.
          </p>
          <a class="plate-call" href={`sms:${site.phone.e164}`} style="margin-top:22px;max-width:420px">
            <span class="prompt">Got the car on order? Ring me before the charger arrives.</span>
            <span class="row">
              <span class="l">TEXT A PHOTO</span>
              <span class="d">{site.phone.display}</span>
            </span>
          </a>
        </div>

        <aside class="paper">
          <div class="head">
            <span class="l">Install spec</span>
            <span class="r">EV wall charger</span>
          </div>
          <img src="/img/tesla-charger.jpg" alt="A Tesla wall connector installed on a wall"
               width="2000" height="2000" loading="lazy" style="padding:14px 14px 0" />
          <dl>
            {evInstallSpec.map((s) => (
              <div class="row"><dt>{s.term}</dt><dd>{s.value}</dd></div>
            ))}
          </dl>
          <p class="fine">
            Every other photograph on this page is our own work.
          </p>
        </aside>
      </div>
    </section>

    <!-- 05 JOB RECORD — the strongest trust asset in the set -->
    <section class="wrap">
      <PlateLabel idx="04" name="Job record" note="VIR rewire" />
      <div class="record">
        <div class="head">
          <span class="l">Job record — VIR rewire</span>
          <span class="r">Auckland</span>
        </div>
        <div class="halves" style="--shot:url('/img/before-after.jpg')">
          <figure>
            <div class="win before"></div>
            <figcaption>
              <span class="chip b">BEFORE</span>
              <p>Perished VIR rubber insulation, original mid-century wiring.</p>
            </figcaption>
          </figure>
          <figure>
            <div class="win after"></div>
            <figcaption>
              <span class="chip a">AFTER</span>
              <p>New TPS, labelled circuits, RCD-protected board.</p>
            </figcaption>
          </figure>
          <div class="why">
            <h3>Why this matters</h3>
            <p>
              VIR is rubber-insulated wiring used in New Zealand houses well into the 1960s.
              The rubber goes hard and cracks with age, and once it does, the copper underneath
              can end up bare inside your walls. If your house is that era and has never been
              rewired, it is worth having someone look at it.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 06 JOB LOG — every tile captioned. The cheapest upgrade from
         "photo grid" to "portfolio" there is. -->
    <section class="wrap">
      <PlateLabel idx="06" name="The job log" note="Recent work, Auckland" />
      <div class="log">
        {jobLog.map((j) => (
          <figure>
            <img src={j.img} alt={`${j.job} — ${j.prop}`} width="800" height="800" loading="lazy" />
            <figcaption>
              <span class="job">{j.job}</span>
              <span class="loc">{j.suburb ? `${j.prop}, ${j.suburb}` : j.prop}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- 07 COMPLIANCE -->
    <section class="compliance">
      <img class="bg" src="/img/banner.jpg" alt="" aria-hidden="true" loading="lazy" />
      <div class="wrap inner">
        <h2 class="h2">Check us before you let anyone near your switchboard</h2>
        <p class="lede">
          Look it up on ewrb.govt.nz before anyone comes near your switchboard — for us,
          or for the next quote you get.
        </p>
        <div class="certs">
          <div class="cert">
            <span class="n">EWRB registered</span>
            {/* Nick's actual registration number drops in here. An invitation to check
                that resolves to nothing is worse than no invitation, so until he sends
                it, this tile states the fact without pretending to a number. */}
            <p>{site.ewrbRegistration
              ? `Registration #${site.ewrbRegistration} — verifiable on ewrb.govt.nz.`
              : 'Registered with the Electrical Workers Registration Board.'}</p>
          </div>
          <div class="cert">
            <span class="n">Certificate of Compliance</span>
            <p>Issued on every job, as the regulations require.</p>
          </div>
          <div class="cert">
            <span class="n">AS/NZS 3000:2018</span>
            <p>All work to the current New Zealand wiring standard.</p>
          </div>
          <div class="cert">
            <span class="n">Manufacturer-trained</span>
            <p>EV charger installation, including Tesla wall connectors.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 08 CONTACT CLOSE -->
    <section class="wrap">
      <PlateLabel idx="05" name="Get in touch" note="Te Atatū South, all Auckland" />
      <div class="close-grid">
        <div>
          <h2 class="h2">Give us a ring</h2>
          <a class="close-cta" href={site.phone.href}>
            <span class="stack">
              <span class="l">CALL NICK</span>
              <span class="d">{site.phone.display}</span>
            </span>
            <span class="chev" aria-hidden="true">›</span>
          </a>
          <div class="close-sub">
            <a href={`sms:${site.phone.e164}`}><span>Or text a photo of the problem</span></a>
            <!--email_off--><a href={`mailto:${site.email}?subject=Website%20enquiry`}><span>{site.email}</span></a><!--/email_off-->
          </div>
          <p class="honest">
            On a busy week you might not get Nick first ring — someone’s usually up a ladder.
            Leave a message or text a photo and one of us will come back to you.
          </p>
        </div>
        <dl class="schedule">
          <div class="row"><dt>Hours</dt><dd>{site.openingHoursDisplay}</dd></div>
          <div class="row"><dt>Based</dt><dd>{site.address.locality}, {site.address.region}</dd></div>
          <div class="row"><dt>Covering</dt><dd>All Auckland</dd></div>
          <div class="row"><dt>Reviews</dt><dd>{site.rating.value} from {site.rating.count}</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Footer />
  <CallBar />
</Base>
