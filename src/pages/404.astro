---
import Base from '../layouts/Base.astro'
import { site } from '../data/site'
---
<Base title={`Page not found | ${site.name}`} description="That page doesn't exist." path="/404/">
  <main id="main" class="notfound">
    <h1>Page not found</h1>
    <p>That page doesn't exist — but we're still the right sparky.</p>
    <a class="btn-call" href={site.phone.href}>Call {site.phone.display}</a>
    <p><a href="/">Back to the homepage</a></p>
  </main>
</Base>
