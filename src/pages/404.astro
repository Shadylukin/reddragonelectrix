---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CallBar from '../components/CallBar.astro'
import { site } from '../data/site'
---
<Base title={`Page not found | ${site.name}`} description="That page doesn't exist." path="/404/">
  <Header />
  <main id="main">
    <section class="wrap">
      <h1 class="h1">Page not found<span class="accent">Ring Nick anyway.</span></h1>
      <p class="lede">That page doesn't exist — but we're still the right sparky.</p>
      <a class="close-cta" href={site.phone.href}>
        <span class="stack">
          <span class="l">CALL NICK</span>
          <span class="d">{site.phone.display}</span>
        </span>
        <span class="chev" aria-hidden="true">›</span>
      </a>
      <p class="honest"><a href="/">Back to the homepage</a></p>
    </section>
  </main>
  <Footer />
  <CallBar />
</Base>
