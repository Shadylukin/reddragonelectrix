---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CallBar from '../components/CallBar.astro'
import PlateLabel from '../components/PlateLabel.astro'
import EnquiryForm from '../components/EnquiryForm.astro'
import { site } from '../data/site'
const title = `Contact | ${site.name}`
const description = `Call Red Dragon Electrix on ${site.phone.display}, or text a photo of the problem. Registered electricians covering all of Auckland, open ${site.openingHoursDisplay}.`
---
<Base title={title} description={description} path="/contact/">
  <Header current="contact" />
  <main id="main">
    <section class="wrap">
      <PlateLabel idx="01" name="Get in touch" note="Glen Eden, all Auckland" />
      <div class="close-grid">
        <div>
          <h1 class="h1">Ring Nick<span class="accent">0210 918 6333</span></h1>
          <a class="close-cta" href={site.phone.href}>
            <span class="stack">
              <span class="l">CALL NICK</span>
              <span class="d">{site.phone.display}</span>
            </span>
            <span class="chev" aria-hidden="true">›</span>
          </a>
          <div class="close-sub">
            <a href={`sms:${site.phone.e164}`}><span>Or text a photo of the problem</span></a>
            <a href={`mailto:${site.email}?subject=Website%20enquiry`}><span>{site.email}</span></a>
          </div>
          <p class="honest">
            On a busy week you might not get him first ring — he's usually up a ladder.
            Leave a message or text a photo of what's going on and he'll come back to you.
          </p>
          <EnquiryForm defaultJobType="ev" />
        </div>
        <dl class="schedule">
          <div class="row"><dt>Phone</dt><dd>{site.phone.display}</dd></div>
          <div class="row"><dt>Email</dt><dd>{site.email}</dd></div>
          <div class="row"><dt>Hours</dt><dd>{site.openingHoursDisplay}</dd></div>
          <div class="row"><dt>Based</dt><dd>{site.address.locality}, {site.address.region}</dd></div>
          <div class="row"><dt>Covering</dt><dd>All Auckland</dd></div>
          <div class="row"><dt>Facebook</dt><dd><a href={site.facebook} rel="noopener">/reddragonelectrix</a></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Footer />
  <CallBar />
</Base>
